{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "build:github": "npm ci && nuxt build --preset github-pages",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "thumbs": "node scripts/generate-thumbs.mjs",
    "lint:data": "node scripts/lint-gallery-data.mjs"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/icon": "^2.2.1",
    "@pinia/nuxt": "^0.11.3",
    "@types/formidable": "^3.4.5",
    "@vueuse/core": "13.9",
    "@vueuse/nuxt": "13.9",
    "eslint": "^9.39.4",
    "exifr": "^7.1.3",
    "formidable": "^3.5.4",
    "leaflet": "^1.9.4",
    "nuxt": "^4.4.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@headlessui/tailwindcss": "^0.2.2",
    "@iconify-json/lucide": "^1.2.102",
    "@playwright/test": "^1.59.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.1",
    "autoprefixer": "10.5",
    "nuxt-headlessui": "^1.2.2",
    "postcss": "8.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "typescript": "5.9",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "esbuild": "0.27.4"
  }
}
