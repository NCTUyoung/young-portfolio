# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Claude Code git worktrees (nested checkouts — never commit into the main repo)
.claude/worktrees/

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Playwright CLI snapshots / screenshots（本機 review 產出的暫存，不入版控）
.playwright-cli/
.tmp/
hero-*.png
home-*.png
gallery-review*.png
live-*.png
ykit-*.png
rail-*.png

# Wiki / inspiration ingest 暫存（Playwright a11y snapshot、screenshot 腳本等）
# 規則：散落 root 的 yml/snap-tmp 一律不入版，建議跑 ingest 時直接寫進 .tmp/
/*.yml
!/.github/**
.snap-tmp.*

# 視覺驗收：current/ 為本次跑出來的對照圖、baseline/ 是要 commit 的基準
# diff/ 是 gallery-visual-diff skill 跑出來的紅色覆蓋差異圖
tests/screenshots/current/
tests/screenshots/diff/

# boot-worktree skill 在 worktree dir 寫的 ready-state 標記
.dev-ready.json
.dev.log
.dev.err.log

# Author-download skill 產出與輸入清單（本機用，含他人作品）
downloads/
ig-urls.json

# Python bytecode（claude skills 內 helper scripts 跑過會產生）
__pycache__/
*.pyc

# Playwright e2e runner 產物
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Wiki：由 wiki/.git 獨立追蹤（local-only），主 repo 不管
wiki/

# 視覺驗收 round 輸出（act-critic 各輪截圖，本機暫存；baseline/ 仍入庫）
tests/screenshots/rounds/

# 本機 AI 工具的暫存目錄（skills 鏡像 / 設定，非站台原始碼）
.agents/
.codex/

# 大型本機素材與 profiling traces（勿入庫）
/*.mp4
Trace-*.json.gz
